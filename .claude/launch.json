{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "serve",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "serve.py",
        "--port",
        "5001"
      ],
      "port": 5001
    }
  ]
}
